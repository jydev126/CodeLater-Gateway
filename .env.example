# Replace with at least 20 random characters. CHANGE_ME is rejected at startup.
# Use a single-quoted value in .env if it contains $ or #. Never commit .env.
GATEWAY_PASSWORD=CHANGE_ME
# Optional: takes priority; mount the file into the container first.
# GATEWAY_PASSWORD_FILE=/run/secrets/gateway_password

LISTEN_HOST=0.0.0.0
LISTEN_PORT=8765

# Replace this example with the smallest CIDRs covering your actual targets.
ALLOWED_TARGET_CIDRS=10.0.0.0/8
ALLOWED_TARGET_PORTS=22
CODELATER_LAN_NETWORK=lan

CONNECT_TIMEOUT_SECONDS=5
TARGET_HANDSHAKE_TIMEOUT_SECONDS=5
MAX_CONNECTIONS=8
MAX_CONNECTIONS_PER_IP=4
AUTH_FAIL_LIMIT=5
AUTH_FAIL_WINDOW_SECONDS=300
AUTH_BLOCK_SECONDS=900
IDLE_TIMEOUT_SECONDS=1800

TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
ALLOW_ORIGIN=
